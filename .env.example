# Telegram bot token from @BotFather. Never commit the real .env file.
BOT_TOKEN=123456:replace_me
# Public HTTPS URL of the Railway deployment, without trailing slash
APP_URL=https://your-app.up.railway.app
# Comma-separated numeric Telegram user IDs with full admin access
ADMIN_IDS=123456789
# Optional: path for SQLite database (Railway volume recommended)
DATABASE_PATH=./data/playerok-garant.sqlite
# Optional server port (Railway provides PORT automatically)
PORT=3000
# Optional bot welcome banner image URL (HTTPS)
WELCOME_PHOTO_URL=
# Set true only for local development with Telegram initData validation bypassed.
# Keep false/omit in production.
DEV_AUTH_BYPASS=false
